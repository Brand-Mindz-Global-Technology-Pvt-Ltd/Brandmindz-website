# MySQL (set these in Hostinger hPanel > Node.js app > Environment variables)
# Never commit the real password or a production .env file.
DB_HOST=srv1516.hstgr.io
DB_PORT=3306
DB_CONNECTION_LIMIT=10
DB_MAX_IDLE=5
DB_IDLE_TIMEOUT_MS=60000
DB_CONNECT_TIMEOUT_MS=10000
DB_USER=your_hostinger_mysql_user
DB_PASSWORD=BrandmindZ@123
DB_NAME=your_hostinger_database
DB_SSL=false

# The API must listen on the port assigned by Hostinger.
PORT=3007
NODE_ENV=production

# Enquiry notifications (choose SendGrid OR SMTP)
ENQUIRY_TO_EMAIL=business@brandmindz.com
MAIL_FROM=business@brandmindz.com

# SendGrid
SENDGRID_API_KEY=

# SMTP alternative (for Gmail use smtp.gmail.com, port 587, and an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
